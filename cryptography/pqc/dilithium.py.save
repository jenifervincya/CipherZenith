"""
dilithium.py — CRYSTALS-Dilithium Digital Signatures
CipherZenith | ByteStorm Crew | Tamilvel Mugunthan S

What is Dilithium?
  - NIST standard: ML-DSA (FIPS 204) — finalized 2024
  - Lattice-based digital signature scheme
  - Quantum-safe replacement for ECDSA and RSA signatures
  - Proves a transaction was genuinely sent by the real sender
  - Any tampering with the message makes verification fail

Why signatures alongside encryption?
  - Kyber handles CONFIDENTIALITY  — nobody can read the data
  - Dilithium handles AUTHENTICITY — nobody can fake the sender
  - Together: data is both secret AND verified

Dilithium levels:
  Dilithium2 → NIST Level 2 — used for LOW/MEDIUM risk
  Dilithium3 → NIST Level 3 — used for HIGH risk

Called by: hybrid/hybrid_scheme.py (optional layer)
"""

import oqs
import base64
import json
import hashlib


# ── Algorithm selection ────────────────────────────────────────────────────────

ALGORITHMS = {
    "ML-DSA-44" : "Dilithium2",   # LOW/MEDIUM — faster, smaller signatures
    "ML-DSA-65" : "Dilithium3",   # HIGH risk  — stronger security
}

DEFAULT_ALGORITHM = "ML-DSA-44"


def _get_algo_name(algorithm: str) -> str:
    key = algorithm.lower().replace("-", "").replace(" ", "")
    if key not in ALGORITHMS:
        raise ValueError(f"Unknown algorithm '{algorithm}'. Choose: ML-DSA-44, ML-DSA-65")
    return ALGORITHMS[key]


# ── Key Generation ─────────────────────────────────────────────────────────────

def generate_signing_keypair(algorithm: str = DEFAULT_ALGORITHM) -> dict:
    """
    Generate a Dilithium signing keypair.

    Args:
        algorithm : "ML-DSA-44" or "ML-DSA-65"

    Returns dict with:
        public_key       : base64 — share with anyone who needs to verify
        private_key      : base64 — keep SECRET, used to sign
        algorithm        : algorithm name
        public_key_size  : bytes
        private_key_size : bytes
    """
    algo_name = _get_algo_name(algorithm)

    with oqs.Signature(algo_name) as signer:
        public_key  = signer.generate_keypair()
        private_key = signer.export_secret_key()

    return {
        "public_key"       : base64.b64encode(public_key).decode(),
        "private_key"      : base64.b64encode(private_key).decode(),
        "algorithm"        : algo_name,
        "public_key_size"  : len(public_key),
        "private_key_size" : len(private_key),
    }


# ── Sign ───────────────────────────────────────────────────────────────────────

def sign(message: str, private_key_b64: str,
         algorithm: str = DEFAULT_ALGORITHM) -> dict:
    """
    Sign a message using the private key.
    Called when a transaction is sent — proves it came from the real sender.

    Args:
        message        : string to sign (transaction JSON)
        private_key_b64: base64 private key from generate_signing_keypair()
        algorithm      : must match the keypair algorithm

    Returns dict with:
        signature      : base64 encoded signature
        message_hash   : SHA-256 hash of message (for reference)
        algorithm      : algorithm used
        signature_size : bytes

    Note:
        The signature is over the raw message bytes.
        Even changing one character invalidates the signature.
    """
    algo_name   = _get_algo_name(algorithm)
    private_key = base64.b64decode(private_key_b64)
    msg_bytes   = message.encode("utf-8")

    with oqs.Signature(algo_name, secret_key=private_key) as signer:
        signature = signer.sign(msg_bytes)

    return {
        "signature"      : base64.b64encode(signature).decode(),
        "message_hash"   : hashlib.sha256(msg_bytes).hexdigest(),
        "algorithm"      : algo_name,
        "signature_size" : len(signature),
    }


# ── Verify ─────────────────────────────────────────────────────────────────────

def verify(message: str, signature_b64: str,
           public_key_b64: str, algorithm: str = DEFAULT_ALGORITHM) -> dict:
    """
    Verify a signature using the sender's public key.
    Called at the receiving end to confirm the transaction is genuine.

    Args:
        message        : original message string
        signature_b64  : base64 signature from sign()
        public_key_b64 : sender's public key
        algorithm      : must match signing algorithm

    Returns dict with:
        valid     : True if signature is genuine, False if tampered/forged
        algorithm : algorithm used
        message   : echoed back

    Security:
        Returns False if:
        - Message was modified after signing
        - Signature was forged
        - Wrong public key used
        Returns True ONLY if everything matches exactly.
    """
    algo_name   = _get_algo_name(algorithm)
    public_key  = base64.b64decode(public_key_b64)
    signature   = base64.b64decode(signature_b64)
    msg_bytes   = message.encode("utf-8")

    with oqs.Signature(algo_name) as verifier:
        is_valid = verifier.verify(msg_bytes, signature, public_key)

    return {
        "valid"     : is_valid,
        "algorithm" : algo_name,
        "message"   : message,
    }


# ── Sign a transaction dict ────────────────────────────────────────────────────

def sign_transaction(transaction: dict, private_key_b64: str,
                     algorithm: str = DEFAULT_ALGORITHM) -> dict:
    """
    Convenience wrapper — sign a transaction dict directly.
    Serialises to JSON first, then signs.
    """
    message = json.dumps(transaction, sort_keys=True)
    return sign(message, private_key_b64, algorithm)


def verify_transaction(transaction: dict, signature_b64: str,
                       public_key_b64: str, algorithm: str = DEFAULT_ALGORITHM) -> dict:
    """
    Convenience wrapper — verify a transaction dict directly.
    """
    message = json.dumps(transaction, sort_keys=True)
    return verify(message, signature_b64, public_key_b64, algorithm)


# ── Self-test ──────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    print("=" * 58)
    print("  CipherZenith — CRYSTALS-Dilithium Signature Test")
    print("=" * 58)

    transaction = {
        "sender"    : "Jeni",
        "receiver"  : "Mugunthan",
        "amount"    : 500,
        "txn_id"    : "TXN-20240622-001",
        "timestamp" : "2024-06-22T10:30:00"
    }

    for algo in ["ML-DSA-44", "ML-DSA-65"]:
        print(f"\n{'─'*58}")
        print(f"  Testing {algo.upper()}")
        print(f"{'─'*58}")

        # Step 1 — generate keypair
        print(f"\n[1] Generating {algo} signing keypair...")
        keypair = generate_signing_keypair(algo)
        print(f"    Algorithm      : {keypair['algorithm']}")
        print(f"    Public key     : {keypair['public_key_size']} bytes")
        print(f"    Private key    : {keypair['private_key_size']} bytes")
        print(f"    (ECDSA public key = 64 bytes for comparison)")

        # Step 2 — sign transaction
        print(f"\n[2] Signing transaction...")
        print(f"    Transaction : {json.dumps(transaction)}")
        signed = sign_transaction(transaction, keypair["private_key"], algo)
        print(f"    Signature   : {signed['signature'][:48]}...")
        print(f"    Sig size    : {signed['signature_size']} bytes")
        print(f"    Msg hash    : {signed['message_hash'][:32]}...")

        # Step 3 — verify genuine
        print(f"\n[3] Verifying genuine signature...")
        result = verify_transaction(
            transaction, signed["signature"], keypair["public_key"], algo
        )
        print(f"    Valid       : {result['valid']}")
        print(f"    [{'PASS' if result['valid'] else 'FAIL'}] Genuine signature verified")

        # Step 4 — tamper test
        print(f"\n[4] Tamper test — modifying amount from 500 to 99999...")
        tampered_tx = {**transaction, "amount": 99999}
        tamper_result = verify_transaction(
            tampered_tx, signed["signature"], keypair["public_key"], algo
        )
        print(f"    Valid       : {tamper_result['valid']}")
        print(f"    [{'PASS' if not tamper_result['valid'] else 'FAIL'}] Tampered transaction rejected")

        # Step 5 — wrong key test
        print(f"\n[5] Wrong key test — using different keypair to verify...")
        fake_keypair = generate_signing_keypair(algo)
        wrong_key_result = verify_transaction(
            transaction, signed["signature"], fake_keypair["public_key"], algo
        )
        print(f"    Valid       : {wrong_key_result['valid']}")
        print(f"    [{'PASS' if not wrong_key_result['valid'] else 'FAIL'}] Forged key rejected")

    print(f"\n{'='*58}")
    print(f"  All Dilithium tests passed!")
    print(f"  Signatures: quantum-safe, tamper-proof, forgery-proof")
    print(f"{'='*58}")
